<Project>
  <UsingTask TaskName="AdHoc.Build.VersionTags.ParseVersionTags"
		AssemblyFile="../tools/AdHoc.Build.VersionTags.dll" />
  <UsingTask TaskName="AdHoc.Build.VersionTags.ImportVersionTagsCheck"
		AssemblyFile="../tools/AdHoc.Build.VersionTags.dll" />
  <UsingTask TaskName="AdHoc.Build.VersionTags.DispatchPack"
		AssemblyFile="../tools/AdHoc.Build.VersionTags.dll" />

  <Target Name="GetVersionTags"
          Inputs="$(VersionTags);$(DefineVersionTagConstants);@(VersionTags)"
          Outputs="$(VersionTags);$(DefineVersionTagConstants);@(VersionTags)">
    <PropertyGroup Condition="'$(DefineVersionTagConstants)' != 'false'">
      <DefineVersionTagConstants>true</DefineVersionTagConstants>
    </PropertyGroup>
    <AdHoc.Build.VersionTags.ParseVersionTags VersionTags="$(VersionTags)" VersionTagItems="@(VersionTags)">
      <Output TaskParameter="VersionTags" PropertyName="VersionTags" />
      <Output TaskParameter="VersionTagItems" ItemName="_VersionTags" />
      <Output TaskParameter="BuildVersion" PropertyName="_VersionTagsBuildVersion" />
      <Output TaskParameter="Constants" PropertyName="_VersionTagsConstants" />
    </AdHoc.Build.VersionTags.ParseVersionTags>
    <ItemGroup>
      <VersionTags Remove="@(VersionTags)" />
      <VersionTags Include="@(_VersionTags)" />
    </ItemGroup>
  </Target>

  <Target Name="_DefineVersionTagConstants" DependsOnTargets="GetVersionTags" BeforeTargets="AddImplicitDefineConstants;CoreCompile">
    <PropertyGroup Condition="'$(DefineVersionTagConstants)' == 'true' AND '$(_VersionTagsConstants)' != ''">
      <DefineConstants>$(DefineConstants);$(_VersionTagsConstants)</DefineConstants>
    </PropertyGroup>
  </Target>

  <PropertyGroup>
    <GetPackageVersionDependsOn>$(GetPackageVersionDependsOn);_SetPackageVersionTag</GetPackageVersionDependsOn>
  </PropertyGroup>
  <Target Name="_SetPackageVersionTag" DependsOnTargets="GetVersionTags">
    <PropertyGroup Condition="'$(_VersionTagsBuildVersion)' != ''">
      <PackageVersion>$(PackageVersion).$(_VersionTagsBuildVersion)</PackageVersion>
    </PropertyGroup>
  </Target>

  <Target Name="_ImportVersionTagsCheck"
			DependsOnTargets="GetVersionTags"
			BeforeTargets="GenerateNuspec"
			Condition="'$(IsPackable)' == 'true'">
    <AdHoc.Build.VersionTags.ImportVersionTagsCheck
			PackageId="$(PackageId)"
			OutputPath="$(BaseIntermediateOutputPath)"
			Items="@(None)"
		>
      <Output TaskParameter="PackItems" ItemName="_VersionTagsPackItems" />
      <Output TaskParameter="RemoveItems" ItemName="_VersionTagsRemoveItems" />
    </AdHoc.Build.VersionTags.ImportVersionTagsCheck>

    <ItemGroup>
      <_PackageFiles Remove="@(_VersionTagsRemoveItems)" />
      <_PackageFiles Include="$(MSBuildThisFileDirectory)../tools/AdHoc.Build.VersionTags.Transitive.dll" Visible="false"
				  Pack="true" PackagePath="tools" />
      <_PackageFiles Include="@(_VersionTagsPackItems)" />
    </ItemGroup>
  </Target>

  <Target Name="_DispatchVersionTagsPack" AfterTargets="Pack" Condition="'$(_IsVersionTagsPack)' != 'true'">
    <AdHoc.Build.VersionTags.DispatchPack
      ProjectFile="$(MSBuildProjectFullPath)" PackageId="$(PackageId)"
      VersionTags="$(VersionTags)" VersionTagItems="@(VersionTags)" />
  </Target>
</Project>
