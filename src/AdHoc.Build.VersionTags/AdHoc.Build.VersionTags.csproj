<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>netstandard2.0</TargetFramework>

    <GenerateDependencyFile>false</GenerateDependencyFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AdHoc.Build.VersionTags.Transitive/AdHoc.Build.VersionTags.Transitive.csproj" PrivateAssets="all" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build/**" Pack="true" PackagePath="build" />
    <None Include="buildMultiTargeting/**" Pack="true" PackagePath="buildMultiTargeting" />
  </ItemGroup>
  
  <Target Name="_IncludeToolsInPackage" BeforeTargets="GenerateNuspec">
    <Message Importance="high" Text="Including AdHoc.Build.VersionTags.dll and AdHoc.Build.VersionTags.Transitive.dll in package tools folder from $(OutputPath)." />
    <ItemGroup>
      <_PackageFiles Include="$(OutputPath)$(AssemblyName).dll" PackagePath="tools" />
      <_PackageFiles Include="../AdHoc.Build.VersionTags.Transitive/$(OutputPath)$(AssemblyName).Transitive.dll" PackagePath="tools" />
    </ItemGroup>
  </Target>
</Project>
